local telemetry
do
    local ok, module_or_error = pcall(require, "main.telemetry")
    if ok then
        telemetry = module_or_error
    else
        print("BS_TELEMETRY disabled require_error=" .. tostring(module_or_error))
    end
end

local function telemetry_call(self, name, ...)
    if not telemetry or not self.telemetry then return nil end
    local fn = telemetry[name]
    if not fn then return nil end
    local ok, result = pcall(fn, self.telemetry, ...)
    if not ok then
        print("BS_TELEMETRY disabled runtime_error=" .. tostring(result))
        self.telemetry = nil
        return nil
    end
    return result
end

local W, H = 1280, 720
local BUBBLE_X = { 310, 640, 970 }
local BUBBLE_Y = 315
local BUBBLE_SIZE = vmath.vector3(230, 230, 0)
local NORMAL = vmath.vector4(0.08, 0.55, 0.72, 0.92)
local FOCUSED = vmath.vector4(1.0, 0.76, 0.18, 1.0)
local WHITE = vmath.vector4(1, 1, 1, 1)
local DIM = vmath.vector4(0.02, 0.06, 0.11, 0.94)

local function now_ms()
    return socket and socket.gettime and socket.gettime() * 1000 or os.clock() * 1000
end

local function metric(name, fields)
    local parts = { "BS_METRIC", name }
    if fields then
        for k, v in pairs(fields) do
            parts[#parts + 1] = tostring(k) .. "=" .. tostring(v)
        end
    end
    print(table.concat(parts, " "))
end

local function new_text(text, x, y, scale)
    local node = gui.new_text_node(vmath.vector3(x, y, 0), text)
    gui.set_font(node, "system_font")
    gui.set_color(node, WHITE)
    gui.set_scale(node, vmath.vector3(scale or 1.0, scale or 1.0, 1))
    return node
end

local function delete_node(node)
    if node then gui.delete_node(node) end
end

local function set_focus(self, index)
    local old = self.focus
    self.focus = math.max(1, math.min(3, index))
    for i = 1, 3 do
        local node = self.bubbles[i]
        gui.cancel_animation(node, gui.PROP_SCALE)
        gui.cancel_animation(node, gui.PROP_COLOR)
        local selected = i == self.focus
        gui.animate(node, gui.PROP_SCALE, selected and vmath.vector3(1.10, 1.10, 1) or vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.11)
        gui.animate(node, gui.PROP_COLOR, selected and FOCUSED or NORMAL, gui.EASING_OUTQUAD, 0.08)
    end
    if old ~= self.focus then
        metric("focus_changed", { from = old or 0, to = self.focus, q = self.question_index })
        telemetry_call(self, "record_focus")
    end
end

local function clear_confetti(self)
    for _, node in ipairs(self.confetti) do delete_node(node) end
    self.confetti = {}
end

local function spawn_confetti(self)
    clear_confetti(self)
    local colors = {
        vmath.vector4(1, .3, .3, 1), vmath.vector4(.3, 1, .5, 1),
        vmath.vector4(.3, .7, 1, 1), vmath.vector4(1, .85, .2, 1)
    }
    for i = 1, 28 do
        local x = 100 + ((i * 149) % 1080)
        local y = 610 + ((i * 47) % 80)
        local n = gui.new_box_node(vmath.vector3(x, y, 4), vmath.vector3(12 + (i % 4) * 4, 20, 0))
        gui.set_color(n, colors[(i % #colors) + 1])
        self.confetti[#self.confetti + 1] = n
        local tx = x + ((i % 2 == 0) and 70 or -70)
        local ty = 70 + ((i * 31) % 170)
        gui.animate(n, gui.PROP_POSITION, vmath.vector3(tx, ty, 4), gui.EASING_INQUAD, 0.75 + (i % 5) * 0.05, 0, function()
            gui.set_enabled(n, false)
        end)
        gui.animate(n, gui.PROP_EULER, vmath.vector3(0, 0, i * 70), gui.EASING_LINEAR, 0.8)
    end
end

local function hide_feedback(self)
    if self.feedback_box then gui.set_enabled(self.feedback_box, false) end
    if self.feedback_text then gui.set_enabled(self.feedback_text, false) end
end

local function show_feedback(self)
    gui.set_enabled(self.feedback_box, true)
    gui.set_enabled(self.feedback_text, true)
    gui.set_scale(self.feedback_box, vmath.vector3(.3, .3, 1))
    gui.animate(self.feedback_box, gui.PROP_SCALE, vmath.vector3(1, 1, 1), gui.EASING_OUTBACK, 0.22)
    spawn_confetti(self)
    if self.sound_enabled then
        msg.post("/main#well_done", "play_sound")
    end
end

local function render_question(self)
    local q = self.questions[self.question_index]
    gui.set_text(self.prompt, q.prompt)
    gui.set_text(self.progress, string.format("%d / %d", self.question_index, #self.questions))
    for i = 1, 3 do
        gui.set_text(self.labels[i], q.choices[i].label)
        if q.type == "color" and q.choices[i].hex then
            local h = q.choices[i].hex:gsub("#", "")
            local r = tonumber(h:sub(1,2), 16) / 255
            local g = tonumber(h:sub(3,4), 16) / 255
            local b = tonumber(h:sub(5,6), 16) / 255
            gui.set_color(self.bubbles[i], vmath.vector4(r, g, b, 1))
        else
            gui.set_color(self.bubbles[i], NORMAL)
        end
    end
    self.focus = 1
    set_focus(self, 1)
    hide_feedback(self)
    metric("question_visible", { id = q.id, index = self.question_index, t_ms = math.floor(now_ms()) })
    telemetry_call(self, "record_question")
end

local function next_question(self)
    local t0 = now_ms()
    self.question_index = self.question_index % #self.questions + 1
    render_question(self)
    local transition_ms = now_ms() - t0
    metric("question_transition", { ms = string.format("%.3f", transition_ms), index = self.question_index })
    telemetry_call(self, "record_transition", transition_ms)
end

local function answer(self)
    local q = self.questions[self.question_index]
    local correct = (self.focus - 1) == q.correct
    metric("answer", { q = q.id, choice = self.focus, correct = correct and 1 or 0, t_ms = math.floor(now_ms()) })
    telemetry_call(self, "record_answer", correct)
    if correct then
        show_feedback(self)
        timer.delay(0.85, false, function() next_question(self) end)
    else
        local node = self.bubbles[self.focus]
        gui.animate(node, "position.x", BUBBLE_X[self.focus] - 16, gui.EASING_OUTQUAD, .06, 0, function()
            gui.animate(node, "position.x", BUBBLE_X[self.focus], gui.EASING_OUTQUAD, .06)
        end)
    end
end

local function set_settings(self, visible)
    self.settings_open = visible
    gui.set_enabled(self.settings_bg, visible)
    gui.set_enabled(self.settings_title, visible)
    gui.set_enabled(self.settings_sound, visible)
    if visible then
        gui.set_text(self.settings_sound, "Sound: " .. (self.sound_enabled and "ON" or "OFF") .. "   [OK to toggle]")
    end
    metric("settings", { open = visible and 1 or 0 })
    if visible then telemetry_call(self, "record_settings_open") end
end

local function init_impl(self)
    msg.post(".", "acquire_input_focus")
    self.started_ms = now_ms()
    self.telemetry = nil
    self.frame_count = 0
    self.slow_frames = 0
    self.max_dt_ms = 0
    self.last_gc_kb = collectgarbage("count")
    self.question_index = 1
    self.focus = 1
    self.sound_enabled = true
    self.settings_open = false
    self.confetti = {}

    local fallback_questions = {
        { id = "animal_fish", type = "animal", prompt = "Choose the fish", correct = 0, choices = {
            { label = "Fish" }, { label = "Turtle" }, { label = "Crab" } } },
        { id = "size_big", type = "size", prompt = "Choose the big one", correct = 1, choices = {
            { label = "Small" }, { label = "Big" }, { label = "Small" } } },
        { id = "color_blue", type = "color", prompt = "Choose blue", correct = 2, choices = {
            { label = "Yellow", hex = "#F4D03F" }, { label = "Red", hex = "#E74C3C" }, { label = "Blue", hex = "#3498DB" } } },
    }
    self.questions = fallback_questions
    local raw = sys.load_resource("/data/ocean_questions.json")
    if raw then
        local ok, data_or_error = pcall(json.decode, raw)
        if ok and data_or_error and data_or_error.questions then
            self.questions = data_or_error.questions
        else
            print("BS_STARTUP question_json_fallback error=" .. tostring(data_or_error))
        end
    else
        print("BS_STARTUP question_json_fallback missing_resource=1")
    end

    self.title = new_text("BUBBLE SAFARI - OCEAN NATIVE", W / 2, 650, 1.25)
    self.prompt = new_text("", W / 2, 545, 1.55)
    self.progress = new_text("", 1140, 665, .85)
    self.hint = new_text("D-pad: move   OK: choose   Back: settings", W / 2, 70, .78)

    self.bubbles = {}
    self.labels = {}
    for i = 1, 3 do
        local bubble = gui.new_box_node(vmath.vector3(BUBBLE_X[i], BUBBLE_Y, 0), BUBBLE_SIZE)
        gui.set_color(bubble, NORMAL)
        self.bubbles[i] = bubble
        self.labels[i] = new_text("", BUBBLE_X[i], BUBBLE_Y, 1.05)
    end

    self.feedback_box = gui.new_box_node(vmath.vector3(W/2, H/2, 5), vmath.vector3(560, 280, 0))
    gui.set_color(self.feedback_box, vmath.vector4(.02, .35, .22, .97))
    self.feedback_text = new_text("أحسنت!", W/2, H/2, 2.0)
    gui.set_position(self.feedback_text, vmath.vector3(W/2, H/2, 6))

    self.settings_bg = gui.new_box_node(vmath.vector3(W/2, H/2, 10), vmath.vector3(760, 430, 0))
    gui.set_color(self.settings_bg, DIM)
    self.settings_title = new_text("Settings", W/2, 455, 1.5)
    gui.set_position(self.settings_title, vmath.vector3(W/2, 455, 11))
    self.settings_sound = new_text("", W/2, 350, 1.0)
    gui.set_position(self.settings_sound, vmath.vector3(W/2, 350, 11))

    set_settings(self, false)
    render_question(self)
    local startup_ms = now_ms() - self.started_ms
    metric("native_ready", { startup_internal_ms = string.format("%.3f", startup_ms) })

    -- Telemetry must never be able to prevent the game UI from starting.
    -- Initialise it only after the first question is already visible and disable it on any error.
    if telemetry and telemetry.new then
        local ok, t_or_error = pcall(telemetry.new)
        if ok then
            self.telemetry = t_or_error
            telemetry_call(self, "set_startup", startup_ms)
            telemetry_call(self, "flush_pending")
            timer.delay(2.0, false, function() telemetry_call(self, "send", "session_start") end)
            self.telemetry_timer = timer.delay(15.0, true, function() telemetry_call(self, "send", "periodic") end)
        else
            print("BS_TELEMETRY disabled init_error=" .. tostring(t_or_error))
        end
    end
end

function init(self)
    self.boot_status = gui.get_node("boot_status")
    self.startup_failed = false
    local ok, err = xpcall(function() init_impl(self) end, function(e)
        if debug and debug.traceback then
            return debug.traceback(tostring(e), 2)
        end
        return tostring(e)
    end)
    if ok then
        gui.set_enabled(self.boot_status, false)
    else
        self.startup_failed = true
        print("BS_FATAL_INIT " .. tostring(err))
        gui.set_text(self.boot_status, "STARTUP ERROR")
        gui.set_color(self.boot_status, vmath.vector4(1.0, 0.35, 0.25, 1.0))
        gui.set_enabled(self.boot_status, true)
    end
end

function update(self, dt)
    if self.startup_failed then return end
    local dt_ms = dt * 1000
    telemetry_call(self, "record_frame", dt_ms)
    self.frame_count = self.frame_count + 1
    if dt_ms > self.max_dt_ms then self.max_dt_ms = dt_ms end
    if dt_ms > 25 then
        self.slow_frames = self.slow_frames + 1
        metric("slow_frame", { dt_ms = string.format("%.3f", dt_ms), frame = self.frame_count })
    end
    if self.frame_count % 300 == 0 then
        local gc = collectgarbage("count")
        metric("runtime_sample", {
            frames = self.frame_count,
            max_dt_ms = string.format("%.3f", self.max_dt_ms),
            slow = self.slow_frames,
            gc_kb = string.format("%.1f", gc),
            gc_delta_kb = string.format("%.1f", gc - self.last_gc_kb)
        })
        self.last_gc_kb = gc
        self.max_dt_ms = 0
        self.slow_frames = 0
    end
end

function on_input(self, action_id, action)
    if self.startup_failed then return false end
    if not action.pressed then return false end
    local input_t = now_ms()

    if action_id == hash("back") then
        set_settings(self, not self.settings_open)
        local handled_ms = now_ms() - input_t
        telemetry_call(self, "record_input", handled_ms)
        metric("input", { key = "back", handled_ms = string.format("%.3f", handled_ms) })
        return true
    end

    if self.settings_open then
        if action_id == hash("ok") then
            self.sound_enabled = not self.sound_enabled
            gui.set_text(self.settings_sound, "Sound: " .. (self.sound_enabled and "ON" or "OFF") .. "   [OK to toggle]")
            metric("settings_sound", { enabled = self.sound_enabled and 1 or 0 })
            local handled_ms = now_ms() - input_t
            telemetry_call(self, "record_input", handled_ms)
            metric("input", { key = "settings_ok", handled_ms = string.format("%.3f", handled_ms) })
            return true
        end
        return true
    end

    if action_id == hash("left") or action_id == hash("up") then
        set_focus(self, self.focus - 1)
    elseif action_id == hash("right") or action_id == hash("down") then
        set_focus(self, self.focus + 1)
    elseif action_id == hash("ok") then
        answer(self)
    else
        return false
    end

    local handled_ms = now_ms() - input_t
    telemetry_call(self, "record_input", handled_ms)
    metric("input", { key = tostring(action_id), handled_ms = string.format("%.3f", handled_ms) })
    return true
end

function final(self)
    if self.startup_failed then
        msg.post(".", "release_input_focus")
        return
    end
    if self.telemetry_timer then timer.cancel(self.telemetry_timer) end
    telemetry_call(self, "final")
    metric("session_end", { frames = self.frame_count })
    msg.post(".", "release_input_focus")
end
